#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
  char *buffer;
  size_t buffsize = 0;
  size_t chars;


  printf("Please enter some text: ");

  if (getline(&buffer, &buffsize, stdin) != -1L) {
   chars = getline(&buffer, &buffsize, stdin);
   char *saveptr;
   char *tok = strtok_r(buffer, " ", &saveptr);
   printf("%s", tok);
  } else {
    printf("Memory Allocation Failed");
    return -1;
  }

  free(buffer);
}
