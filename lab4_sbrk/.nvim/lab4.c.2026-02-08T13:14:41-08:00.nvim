#define _DEFAULT_SOURCE
#include <stdio.h>
#include <unistd.h>

struct header1 {};

int main(void) {
  /*Incr Heap Size by 256*/
  void *brk_heap;
  void *new_memory_block;
  brk_heap = sbrk(0);
  new_memory_block = sbrk(256);
  printf("%p\n", brk_heap);
  printf("%p", new_memory_block);

  struct header1 *my_block = (struct header1 *)brk_heap;
  return 0;
}
