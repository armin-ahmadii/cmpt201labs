#define _DEFAULT_SOURCE
#include <stdio.h>
#include <unistd.h>
#include <stdint.h>

struct header {
  uint64_t size;
  struct header* next;
};

int main(void) {
  /*Incr Heap Size by 256*/
  void *new_memory_block;
  new_memory_block = sbrk(256);
  printf("%p", new_memory_block);

  struct header *block1 = (struct header1 *)new_memory_block;
  uint64_t *memory_block_2 = (uint64_t *)new_memory_block + sizeof(struct header); 
  struct header *block2 = (struct header2 *)memory_block_2;

  block1->next = NULL;
  block2->next = block1;
  block1->size = 128;
  block2->size = 128;

  printf(block1->next);
  return 0;
}
