/*
Questions to answer at top of server.c:
(You should not need to change client.c)
Understanding the Client:
1. How is the client sending data to the server? What protocol?  The client uses TCP over IPV4. It
creates a socket, connects to the server at local host, then sends data using write on the socket
fd.
2. What data is the client sending to the server?
It sends 5 string messages: "Hello", "Apple", "Car", "Green", and "Dog". Each is copied into a fixed
1024-byte buffer and sent one per second using a sleep(1) between each write()
Understanding the Server:
1. Explain the argument that the `run_acceptor` thread is passed as an argument.
It receives a pointer to struct acceport_args, which contains three fields:
- run: a bool that main sets to false to signal thread to stop
- list_handle: a pointer to the shared linked list
- list_lock: a pointer to the mutex that protects said shared list.
2. How are received messages stored
Messages are stored in a singly linked list of list node structs. each node holding a mallocd 1024
byte
3. What does `main()` do with the received messages?
After all messages are collected, main() calls collect_all(), whcih walks the linked list from head,
prints each mesage with printf, frees each node, and it data buffer, and then returns the total
count. Main() then checks that the count matches list_handle _> coount and prints
4. How are threads used in this sample code?
main() spawns one acceport thread running run_acceptor(). The acceptor thread spanws one client
thread (run_client()) per connected client, up to MAX_CLIENT. Each client thread independatly reads
from its own soclet.
*/

#include <arpa/inet.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>

#define PORT 8001
#define BUF_SIZE 1024
#define ADDR "127.0.0.1"

#define handle_error(msg)                                                      \
  do {                                                                         \
    perror(msg);                                                               \
    exit(EXIT_FAILURE);                                                        \
  } while (0)

#define NUM_MSG 5

static const char *messages[NUM_MSG] = {"Hello", "Apple", "Car", "Green",
                                        "Dog"};

int main() {
  int sfd = socket(AF_INET, SOCK_STREAM, 0);
  if (sfd == -1) {
    handle_error("socket");
  }

  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(struct sockaddr_in));
  addr.sin_family = AF_INET;
  addr.sin_port = htons(PORT);
  if (inet_pton(AF_INET, ADDR, &addr.sin_addr) <= 0) {
    handle_error("inet_pton");
  }

  if (connect(sfd, (struct sockaddr *)&addr, sizeof(addr)) == -1) {
    handle_error("connect");
  }

  char buf[BUF_SIZE];
  for (int i = 0; i < NUM_MSG; i++) {
    sleep(1);
    // prepare message
    // this pads the desination with NULL
    strncpy(buf, messages[i], BUF_SIZE);

    if (write(sfd, buf, BUF_SIZE) == -1) {
      handle_error("write");
    } else {
      printf("Sent: %s\n", messages[i]);
    }
  }

  exit(EXIT_SUCCESS);
}
