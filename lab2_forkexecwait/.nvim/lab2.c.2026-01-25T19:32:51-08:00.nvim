#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
  char nothing[] = "nothing";
  while (1) {
    pid_t pid;
    pid = fork();
    if (pid == 0) {
      char nameOfProgram[99];
      printf("Enter programs to run.\n");
      scanf("%s", nameOfProgram);
      if (strcmp(nameOfProgram, nothing) == 0) {
        exit(EXIT_SUCCESS);
      }
      execl(nameOfProgram, nameOfProgram, NULL);
    }

    if (pid > 0) {
      wait(NULL);
    }
  }
  return 0;
}
