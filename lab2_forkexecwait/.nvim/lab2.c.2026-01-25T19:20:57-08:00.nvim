#include <stdio.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
  char nameOfProgram[99];
  printf("Enter programs to run.\n");
  scanf("%s", nameOfProgram);
  execl(nameOfProgram, nameOfProgram, NULL);
  while (1) {
    pid_t pid;
    pid = fork();
    if (pid == 0) {
      printf("Enter programs to run.\n");
      scanf("%s", nameOfProgram);
      execl(nameOfProgram, nameOfProgram, NULL);
      return 1;
    }

    if (pid > 0) {
      wait(NULL);
      return 0;
    }
  }
}
